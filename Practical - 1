#include <iostream>
#include <string>
using namespace std;

class PostfixEvaluation {

    static const int MAX = 100;
    static int stack[MAX];
    static int top;

    static void push(int value) {
        stack[++top] = value;
    }

    static int pop() {
        return stack[top--];
    }

public:

    static void evaluate() {

        string postfix;

        cout << "Enter postfix expression: ";
        cin >> postfix;

        for (int i = 0; i < postfix.length(); i++) {

            char ch = postfix[i];

            // If operand, push it
            if (isdigit(ch)) {
                push(ch - '0');
            }

            // If operator, perform operation
            else {

                int b = pop();
                int a = pop();
                int result;

                switch (ch) {

                    case '+':
                        result = a + b;
                        break;

                    case '-':
                        result = a - b;
                        break;

                    case '*':
                        result = a * b;
                        break;

                    case '/':
                        result = a / b;
                        break;

                    default:
                        cout << "Invalid operator!" << endl;
                        return;
                }

                push(result);
            }
        }

        cout << "Result = " << pop() << endl;
    }
};

// Initialize static variables
int PostfixEvaluation::stack[PostfixEvaluation::MAX];
int PostfixEvaluation::top = -1;


int main() {

    PostfixEvaluation::evaluate();

    return 0;
}
